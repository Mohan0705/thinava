# =============================================================================
# THINAVA — Environment Configuration
# =============================================================================
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# Frontend (Next.js) vars use NEXT_PUBLIC_ prefix (visible in browser bundles).
# Backend vars are server-only (loaded from server/.env).
# =============================================================================

# --- API & Backend Connection ---
# Backend API base URL (used by frontend to call Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket server URL (defaults to API base without /api suffix)
NEXT_PUBLIC_SOCKET_URL=

# Supabase Auth public config (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Auth server config (server-only; required for restaurant signup,
# old-user repair, email confirmation repair, and password reset)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional OpenStreetMap configuration. Defaults use public OSM/Nominatim endpoints.
NEXT_PUBLIC_OSM_TILE_URL=
NEXT_PUBLIC_NOMINATIM_BASE_URL=

# --- Cloudinary Image Uploads ---
# Server-only credentials. Never expose CLOUDINARY_API_SECRET with NEXT_PUBLIC_.
# You can either set CLOUDINARY_URL or the three split server vars below.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public cloud name for client-side Cloudinary URL helpers/widgets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
