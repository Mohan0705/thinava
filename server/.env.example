# =============================================================================
# THINAVA — Server Environment Configuration
# =============================================================================
# Copy this file to server/.env for local development:
#   cp server/.env.example server/.env
#
# IMPORTANT: Never commit server/.env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinava

# --- JWT Secrets (one per scope) ---
# Use strong random values: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CUSTOMER_JWT_SECRET=dev-customer-jwt-secret-change-in-production
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-in-production
RIDER_JWT_SECRET=dev-rider-jwt-secret-change-in-production
RESTAURANT_JWT_SECRET=dev-restaurant-jwt-secret-change-in-production
JWT_ISSUER=thinava
JWT_AUDIENCE=thinava-app

# --- OTP ---
# DEV_MODE=true: random OTP shown in UI / logged (no SMS sent)
# DEV_MODE=false: random OTP sent via Twilio (requires TWILIO_* vars)
DEV_MODE=true
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
CUSTOMER_AUTH_SEND_LIMIT_MAX=10
CUSTOMER_AUTH_VERIFY_LIMIT_MAX=20

# # --- Twilio (only needed when DEV_MODE=false) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Rate Limiting ---
API_RATE_LIMIT_MAX=1000

# --- Delivery Logistics ---
DELIVERY_BASE_PAY=0
DELIVERY_PER_KM_RATE=10
DELIVERY_NIGHT_PER_KM_RATE=13
DELIVERY_SURGE_BONUS=10
DELIVERY_RAIN_BONUS=15
DELIVERY_GPS_RADIUS_METERS=75
DELIVERY_RAIN_MODE=false
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=

# --- Support Contact ---
SUPPORT_PHONE=+918978992808
SUPPORT_WHATSAPP=918978992808
SUPPORT_EMAIL=support@thinava.com
