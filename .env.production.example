# =============================================================================
# THINAVA — Production Environment Configuration
# =============================================================================
# Set these vars in your deployment platform:
#   Frontend (Vercel):        vars with NEXT_PUBLIC_ prefix
#   Backend (Render/Railway): server-only vars plus any NEXT_PUBLIC_ values used server-side
# =============================================================================

# ============================================
# FRONTEND (Vercel Environment Variables)
# ============================================
# Backend production API URL
NEXT_PUBLIC_API_URL=https://thinava-api.up.railway.app/api

# WebSocket server URL (typically same host, different path)
NEXT_PUBLIC_SOCKET_URL=https://thinava-api.up.railway.app

# Google Maps API key (public, frontend-safe)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public Cloudinary cloud name for client-side image helpers/widgets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Supabase Auth public config (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# BACKEND (Render/Railway Environment Variables)
# ============================================

# --- Application ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://thinava.vercel.app

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/thinava

# --- JWT Secrets (one per scope, NEVER reuse across environments) ---
CUSTOMER_JWT_SECRET=
ADMIN_JWT_SECRET=
RIDER_JWT_SECRET=
RESTAURANT_JWT_SECRET=
JWT_ISSUER=thinava
JWT_AUDIENCE=thinava-app

# --- Supabase Restaurant Auth (server-only) ---
# Required for restaurant signup, login repair, old-user confirmation repair,
# and password reset. Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OTP & Auth Limits ---
# DEV_MODE=false in production — OTP is random + sent via Twilio
DEV_MODE=false
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
CUSTOMER_AUTH_SEND_LIMIT_MAX=10
CUSTOMER_AUTH_VERIFY_LIMIT_MAX=20

# --- Twilio (required when DEV_MODE=false) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Rate Limiting ---
API_RATE_LIMIT_MAX=1000

# --- Delivery Logistics ---
DELIVERY_BASE_PAY=0
DELIVERY_PER_KM_RATE=10
DELIVERY_NIGHT_PER_KM_RATE=13
DELIVERY_SURGE_BONUS=10
DELIVERY_RAIN_BONUS=15
DELIVERY_GPS_RADIUS_METERS=75
DELIVERY_RAIN_MODE=false
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=

# --- Cloudinary Image Uploads ---
# Set either CLOUDINARY_URL or the three split credentials.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BANNER_FOLDER=thinava/banners

# --- Support Contact ---
SUPPORT_PHONE=+918978992808
SUPPORT_WHATSAPP=918978992808
SUPPORT_EMAIL=support@thinava.com

# --- Seed Admin Credentials (optional, used by npm run seed:admins) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
OPS_ADMIN_EMAIL=
OPS_ADMIN_PASSWORD=
FINANCE_ADMIN_EMAIL=
FINANCE_ADMIN_PASSWORD=
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_PASSWORD=
